# Required. Signs the session cookie; also seals users' private provider keys.
# Use a long random string (e.g. `openssl rand -base64 32`). Minimum 16 chars.
# Changing it signs everyone out and makes stored private keys unreadable.
JWT_SECRET=

# The shared model credential, used by any account without its own key.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Emergency only: set to any non-empty value to release the administrator latch
# so the next visitor to complete setup becomes the administrator. Unset it once
# you have recovered the seat, or the latch stays clearable by whoever arrives.
DSH_ADMIN_RESET=
